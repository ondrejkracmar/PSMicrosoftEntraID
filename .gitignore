src/PSMicrosoftEntraID/internal/functions/subscription/Update-PSEntraIDSubscribedLicenseDisplayName.ps1

# Build output: vsts-build.ps1 assembles the shippable module here, including the
# compiled psm1 and the C# library. Never committed - the pipeline rebuilds it.
src/publish/

# Pester writes its NUnit result file here when the build script runs locally.
TestResults/

# MAML help generated by build/vsts-createDocumentation.ps1 from the markdown in
# docs/cmdlets. Regenerated on every build; the source of truth is the comment-based
# help in the function files.
src/PSMicrosoftEntraID/en-us/PSMicrosoftEntraID-Help.xml

# Visual Studio's private per-solution state: symbol and code-chunk databases, Copilot
# chat sessions and its point-in-time source snapshots. None of it is input to a build
# and none of it is anyone else's business. 204 files of it were tracked until now.
.vs/

# MSBuild intermediates. Regenerated by every build, and committing them means every
# build produces a diff.
obj/

# Whoever's tenant the scenario scripts are pointed at. Ids are not secrets, but they are
# nobody else's business and a committed one is how somebody ends up running a write
# scenario against the wrong directory. tenant.config.example.json is the template.
tools/tenant.config.json

# Result sets from the scenario scripts (-JsonPath). Run output, not source.
tools/*.result.json

# Compiled output: the CI build (src/build/vsts-build-library.ps1) produces bin/<tfm>/ from
# the .csproj, so the binaries do not belong in git. bin/assembly.ps1 is source and is kept.
**/bin/
**/obj/

# Protected-file patterns of the Read deny rules (standards pack 1.9.0): the git guard blocks a
# sweep (git add -A) while such a file is not ignored.
.claude/settings.local.json
*.env
.env
.env.*
*.key
*.p12
*.pem
*.pfx
*.ppk
secrets/
.secrets/
