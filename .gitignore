# Build output: vsts-build.ps1 assembles the shippable module here, including the
# compiled psm1 and the C# library. Never committed - the pipeline rebuilds it.
src/publish/

# Pester writes its NUnit result file here when the build script runs locally.
TestResults/

# MAML help generated by build/vsts-createDocumentation.ps1 from the markdown in
# docs/cmdlets. Regenerated on every build; the source of truth is the comment-based
# help in the function files.
src/PSMicrosoftEntraID/en-us/PSMicrosoftEntraID-Help.xml

# Visual Studio's private per-solution state: symbol and code-chunk databases, Copilot
# chat sessions and its point-in-time source snapshots. None of it is input to a build
# and none of it is anyone else's business. 204 files of it were tracked until now.
.vs/

# MSBuild intermediates. Regenerated by every build, and committing them means every
# build produces a diff.
obj/
