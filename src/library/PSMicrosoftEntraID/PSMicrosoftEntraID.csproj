<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<AssemblyName>PSMicrosoftEntraID</AssemblyName>
		<RootNamespace>PSMicrosoftEntraID</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Output lands in the module folder split per target framework
		     (bin/net8.0 for PowerShell 7.4/7.5, bin/net10.0 for PowerShell 7.6+).
		     The module loader (bin/assembly.ps1) picks the folder at runtime. -->
		<OutputPath>../../PSMicrosoftEntraID/bin/</OutputPath>
		<AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<PreserveCompilationContext>false</PreserveCompilationContext>
		<PublishTrimmed>false</PublishTrimmed>
		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>false</SelfContained>
		<RuntimeIdentifier></RuntimeIdentifier>
		<!-- žádný RID = žádné runtimes -->
	</PropertyGroup>

	<!--
		Same multi-targeting layout as PSContainerSync: System.Management.Automation
		(reference-only, PrivateAssets) per target framework instead of the full
		Microsoft.PowerShell.SDK. Nothing from these packages is shipped -
		CopyLocalLockFileAssemblies is false and ref/runtimes are deleted below.
		The minimum host follows the net8.0 reference: PowerShell 7.4.
		System.Security.Cryptography.Pkcs comes in transitively through it; it is pinned to the
		version that fixes CVE-2026-84008 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) so the
		dependency scan stays clean. Also reference-only.
	-->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="System.Management.Automation" Version="7.4.13" PrivateAssets="all" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="System.Management.Automation" Version="7.6.1" PrivateAssets="all" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" PrivateAssets="all" />
	</ItemGroup>

	<Target Name="RemoveUnwantedOutputs" AfterTargets="Build">
		<RemoveDir Directories="$(OutputPath)ref" />
		<RemoveDir Directories="$(OutputPath)runtimes" />
	</Target>

</Project>
