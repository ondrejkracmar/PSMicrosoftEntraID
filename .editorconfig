# Root editor settings for everything above src/ (AGENTS.md, README.md, docs/, pipeline YAML).
# A module's src/.editorconfig declares root = true and keeps governing the source tree.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
